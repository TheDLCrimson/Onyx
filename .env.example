# Onyx configuration. Copy this file to `.env` and fill in the required values.
# Step-by-step walkthrough: docs/self-hosting.md
# Keep comments on their own lines; some hosts (Docker env_file, dashboards) don't strip inline comments.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------

# Discord bot token: Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Discord Application ID: Developer Portal -> your application -> General Information.
# Used to register slash commands and to print an invite URL at startup.
DISCORD_CLIENT_ID=

# OpenRouter API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# GitHub token for the account Onyx commits and opens PRs as.
# Solo use: a fine-grained token on your own account, limited to the repos Onyx may touch,
#   with Contents (read/write), Pull requests (read/write) and Metadata (read).
# Shared use: a dedicated bot account with a classic token (`repo` scope); people invite
#   that account as a collaborator and Onyx accepts the invitation automatically.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# Models (optional)
# ------------------------------------------------------------------------------

# Any OpenRouter model id. Comma-separate up to three to get automatic fallback:
# OpenRouter tries them in order when one is rate-limited or unavailable, and
# rejects the request outright if the list is longer than three.
# The heavy tier runs the agent loop, so every model in it must support tool calling.
# Defaults: anthropic/claude-sonnet-4.6 (heavy) and anthropic/claude-haiku-4.5 (light).
# Zero-cost example (free models change often - check https://openrouter.ai/models?q=free):
#   ONYX_MODEL=nex-agi/nex-n2.5-pro:free,poolside/laguna-s-2.1:free,dots-studio/dots-3-note-preview:free
#   ONYX_MODEL_LIGHT=nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free,dots-studio/dots-3-note-preview:free
# CLAUDE_MODEL / CLAUDE_MODEL_LIGHT are still accepted as legacy names.
ONYX_MODEL=
ONYX_MODEL_LIGHT=

# ------------------------------------------------------------------------------
# GitHub (optional)
# ------------------------------------------------------------------------------

# Default repo for channels without a `/repo set` binding. Leave both blank to require /repo set.
GITHUB_OWNER=
GITHUB_REPO=

# Login of the account behind GITHUB_TOKEN. Auto-detected from the token; set only to override.
GITHUB_BOT_USERNAME=

# ------------------------------------------------------------------------------
# Discord (optional)
# ------------------------------------------------------------------------------

# Register commands in this one server only (instant, handy while developing).
# Leave blank to register in every server the bot is in.
DISCORD_GUILD_ID=

# ------------------------------------------------------------------------------
# Behaviour and limits (optional)
# ------------------------------------------------------------------------------

# "true" (default): /create and /edit open a PR. "false": commit straight to the default branch.
ONYX_PR_MODE=

# Daily spend cap per channel in USD (rolling 24h). Blank = unlimited.
# Agent commands refuse to start once a channel reaches it.
ONYX_CHANNEL_BUDGET_USD=

# Active-feature lifetime in days (default 7).
ONYX_SESSION_TIMEOUT_DAYS=

# Rolling conversation-history window in minutes (default 60).
ONYX_CONTEXT_WINDOW_MINUTES=

# How long an interrupted run can be resumed after a bot restart, in minutes (default 60).
ONYX_RESUME_WINDOW_MINUTES=

# Where Onyx keeps its state (sessions, channel bindings, usage log).
# Default: ./data next to the working directory. Point it elsewhere to put state
# on a mounted volume, or to keep a test run away from a live deployment.
ONYX_DATA_DIR=

# Days of history kept in data/usage.json (default 7).
ONYX_USAGE_RETENTION_DAYS=

# ------------------------------------------------------------------------------
# Integration tests only (`pnpm test:integration`)
# ------------------------------------------------------------------------------

# Throwaway repo the integration suite may create branches and PRs in.
GITHUB_TEST_OWNER=
GITHUB_TEST_REPO=
